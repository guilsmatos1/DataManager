# PostgreSQL / TimescaleDB
DATABASE_URL=postgresql://datamanager:changeme@localhost:5432/datamanager

# Docker Compose credentials (used to build DATABASE_URL automatically)
POSTGRES_USER=datamanager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=datamanager

# REST API authentication key
DATAMANAGER_API_KEY=your-secret-api-key-here

# FRED API key (required for economic series)
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here

# Server settings (optional)
DATAMANAGER_HOST=0.0.0.0
DATAMANAGER_PORT=8686
